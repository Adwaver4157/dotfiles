  "model": "claude-fable-5-1[1m]",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/format-on-write.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
