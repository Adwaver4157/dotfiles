#!/usr/bin/env bash
# ============================================================
# tmux-dev: ワンコマンドで開発用tmuxセッションを立ち上げる
#
# Layout:
#   ┌──────────┬─────────┐
#   │          │ lazygit │
#   │   nvim   ├─────────┤
#   │          │  claude │
#   └──────────┴─────────┘
#
# Usage:
#   tmux-dev              # カレントディレクトリで起動
#   tmux-dev ~/projects/foo   # 指定ディレクトリで起動
#
# 既に同名セッションがあればそこにattach（冪等）
# ============================================================

set -e

# ---- 設定（好みで変えてOK） ----
RIGHT_WIDTH="35%"      # 右カラムの幅
RIGHT_SPLIT="50%"      # 右カラム内の上下分割位置
LEFT_CMD="nvim ."      # 左ペインで実行するコマンド
TOP_RIGHT_CMD="lazygit"   # 右上ペインで実行するコマンド
BOT_RIGHT_CMD="claude"    # 右下ペインで実行するコマンド

# ---- ディレクトリ解決 ----
DIR="${1:-$PWD}"
DIR="$(cd "$DIR" && pwd)"  # 絶対パス化

# ---- セッション名（ディレクトリのbasename、ドットは _ に） ----
SESSION="$(basename "$DIR" | tr '.' '_')"

# ---- tmuxの中にいるかで attach/switch を切り替え ----
if [ -n "$TMUX" ]; then
  SWITCH_CMD="switch-client"
else
  SWITCH_CMD="attach-session"
fi

# ---- 既存セッションがあればそこに戻る ----
if tmux has-session -t="$SESSION" 2>/dev/null; then
  tmux "$SWITCH_CMD" -t "$SESSION"
  exit 0
fi

# ---- 新規セッションをdetached状態で作成 ----
# ペイン番号(base-index/pane-base-index)に依存しないよう、
# split のたびに返るペインID(%N)を捕捉して使う
LEFT_PANE="$(tmux new-session -d -s "$SESSION" -c "$DIR" -n editor -P -F '#{pane_id}')"

# 左ペイン: エディタ
tmux send-keys -t "$LEFT_PANE" "$LEFT_CMD" Enter

# 右に分割（横方向）
TOP_RIGHT_PANE="$(tmux split-window -h -l "$RIGHT_WIDTH" -c "$DIR" -t "$LEFT_PANE" -P -F '#{pane_id}')"
tmux send-keys -t "$TOP_RIGHT_PANE" "$TOP_RIGHT_CMD" Enter

# 右ペインを上下に分割
BOT_RIGHT_PANE="$(tmux split-window -v -l "$RIGHT_SPLIT" -c "$DIR" -t "$TOP_RIGHT_PANE" -P -F '#{pane_id}')"
tmux send-keys -t "$BOT_RIGHT_PANE" "$BOT_RIGHT_CMD" Enter

# 左ペイン（エディタ）にフォーカス
tmux select-pane -t "$LEFT_PANE"

# attach / switch
tmux "$SWITCH_CMD" -t "$SESSION"
