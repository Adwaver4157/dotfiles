# ~/.gitconfig (dotfiles) -- generic settings only. No identity lives here.
#
# Who you are, and which name/email/SSH key each remote gets, is configured in
# ~/.gitconfig.local (gitignored, machine-local). It is included LAST below, so
# anything in it overrides this file. Start from ~/.gitconfig.local.example:
#   cp ~/.gitconfig.local.example ~/.gitconfig.local && $EDITOR ~/.gitconfig.local
# Without it, git has no user.name/user.email and refuses to commit -- that is
# intentional: better than committing under a wrong identity.

[init]
	defaultBranch = main
[pull]
	rebase = false
[push]
	default = current
	autoSetupRemote = true
[fetch]
	prune = true
[rerere]
	enabled = true
[core]
	editor = nvim

# --- identity + per-remote routing (private, see above) --------------------
[include]
	path = ~/.gitconfig.local
