# Overlay Claude Code onto an existing GPU training image (the container = sandbox).
# ビルド時に既存の学習イメージを引数で受け取る
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Claude Code に必要な node.js (無ければ)
USER root
RUN apt-get update && apt-get install -y \
      curl git ripgrep tmux \
      ca-certificates gnupg && \
    curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Claude Code
RUN npm install -g @anthropic-ai/claude-code

# 非root ユーザー推奨（既存イメージに合わせて調整）
ARG USERNAME=developer
ARG UID=1000
RUN id -u ${USERNAME} >/dev/null 2>&1 || \
    useradd -m -u ${UID} -s /bin/bash ${USERNAME} && \
    echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

USER ${USERNAME}
WORKDIR /workspace

# Bake deny/permission settings so they apply even under --dangerously-skip-permissions.
# claude_config is a named volume → starts empty; this ensures the deny list exists.
COPY --chown=${USERNAME}:${USERNAME} settings.json /home/${USERNAME}/.claude/settings.json
